# ALLOWLIST. This folder also holds private working files (decks, notes, recordings,
# source photos). Nothing is ever committed unless it is listed here.
/*

# repository and deploy configuration
!/.gitignore
!/wrangler.toml
!/README.md

# the live website (only the files listed below are published)
!/Website/
/Website/*
!/Website/.assetsignore
!/Website/_headers
!/Website/_redirects
!/Website/robots.txt
!/Website/sitemap.xml

# the pages, scripts and styles
!/Website/index.html
!/Website/about.html
!/Website/contact.html
!/Website/projects.html
!/Website/project.html
!/Website/careers.html
!/Website/404.html
!/Website/main.js
!/Website/home.js
!/Website/about.js
!/Website/contact.js
!/Website/projects.js
!/Website/project.js
!/Website/careers.js
!/Website/data.js
!/Website/style.css

# brand files used by the pages
!/Website/mark.svg
!/Website/apple-touch-icon-v6.png
!/Website/logo-full-black-v6.png
!/Website/logo-full-white-v6.png
!/Website/wordmark-white-v6.png

# image folders used by the pages
!/Website/awards/
!/Website/logos/
!/Website/press/
!/Website/stickers/
!/Website/team/
!/Website/work/

.DS_Store
