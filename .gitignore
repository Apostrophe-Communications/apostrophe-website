# ALLOWLIST. This folder also holds private working files (decks, notes, recordings,
# source photos). Nothing is ever committed unless it is listed here.
/*

# site configuration
!/.gitignore
!/.assetsignore
!/_headers
!/_redirects
!/wrangler.toml
!/README.md
!/robots.txt
!/sitemap.xml

# the pages, scripts and styles
!/index.html
!/about.html
!/contact.html
!/projects.html
!/project.html
!/404.html
!/main.js
!/home.js
!/about.js
!/contact.js
!/projects.js
!/project.js
!/data.js
!/style.css

# brand files used by the pages
!/mark.svg
!/apple-touch-icon-v6.png
!/logo-full-black-v6.png
!/logo-full-white-v6.png
!/wordmark-white-v6.png

# image folders used by the pages
!/awards/
!/logos/
!/press/
!/stickers/
!/team/
!/work/

.DS_Store
